# Copia questo file in ".env" e adatta i valori.

# --- Installazione con Docker -------------------------------------------------
# Password del database creato da docker compose. Sceglila lunga e usa solo
# lettere e numeri (finisce dentro un indirizzo di connessione).
POSTGRES_PASSWORD=

# Porta su cui vivamed risponde nella rete dello studio.
VIVAMED_PORT=3000

# --- Installazione manuale / sviluppo -----------------------------------------
# Connessione a PostgreSQL (utente:password@host:porta/database).
# Con Docker non serve: la imposta docker-compose.yml.
DATABASE_URL="postgresql://vivamed:vivamed@localhost:5432/vivamed?schema=public"

# --- Impostazioni comuni --------------------------------------------------------

# Fuso orario dello studio, usato per mostrare gli orari degli appuntamenti.
APP_TIMEZONE="Europe/Rome"

# Cartella dove salvare i documenti dei pazienti (con Docker è già impostata).
UPLOAD_DIR=uploads

# Dimensione massima di ogni documento caricato, in MB.
MAX_UPLOAD_MB=20

# Durata della sessione di login, in ore.
SESSION_HOURS=12

# Metti "true" SOLO se vivamed è raggiunto in https (ad esempio dietro un
# reverse proxy con certificato). In http il browser scarterebbe il cookie di
# sessione e il login non funzionerebbe.
COOKIE_SECURE=false
