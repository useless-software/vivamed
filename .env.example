# Copia questo file in ".env" e adatta i valori.

# Connessione a PostgreSQL (utente:password@host:porta/database).
DATABASE_URL="postgresql://vivamed:vivamed@localhost:5432/vivamed?schema=public"

# Fuso orario dello studio, usato per mostrare gli orari degli appuntamenti.
APP_TIMEZONE="Europe/Rome"

# Durata della sessione di login, in ore.
SESSION_HOURS=12

# Metti "true" SOLO se vivamed è raggiunto in https (ad esempio dietro un
# reverse proxy con certificato). In http il browser scarterebbe il cookie di
# sessione e il login non funzionerebbe.
COOKIE_SECURE=false
